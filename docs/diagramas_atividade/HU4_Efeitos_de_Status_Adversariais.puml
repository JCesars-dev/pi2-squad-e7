@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowFontColor #777777
skinparam ArrowFontSize 11
skinparam ActivityBackgroundColor #1570EF
skinparam ActivityBorderColor #1570EF
skinparam ActivityFontColor #FFFFFF
skinparam ActivityFontStyle bold
skinparam ActivityFontSize 13
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #333333
skinparam ActivityDiamondFontColor #555555
skinparam ActivityDiamondFontStyle italic
skinparam ActivityDiamondFontSize 11
skinparam ActivityStartColor #000000
skinparam ActivityEndColor #000000
skinparam TitleFontSize 15
skinparam TitleFontColor #1570EF
skinparam RoundCorner 20
title US04 — Efeitos de Status Adversariais
start
:Projétil adversarial atinge o jogador;
if (Tipo do projétil?) then ([Confuse — magenta])
  :Aplicar Confusão: inverter eixos WASD/setas;
  :Iniciar contador de 4s;
else ([Blind — roxo])
  :Aplicar Cegueira: máscara escura ao redor do jogador;
  :Iniciar contador de 3,5s;
endif
repeat
  :Decrementar contador do efeito;
repeat while (Contador expirou?) is ([Não]) not ([Sim])
:Remover efeito e voltar ao estado normal;
stop
@enduml
