title US13 — Menu Principal, Instruções e Configurações
start
:Exibir menu principal;
:Exibir guia de controles e catálogo de ameaças;
repeat
  :Aguardar tecla do jogador;
  if (Tecla 1 ou N?) then ([Sim])
    :Selecionar Modo Normal e destacar opção;
  elseif (Tecla 2 ou D?) then ([Sim])
    :Selecionar Modo Difícil e destacar opção;
  else ([Não])
  endif
repeat while (ESPAÇO pressionado?) is ([Não]) not ([Sim])
:Reinicializar jogador, chefe, projéteis, digitação e HUD;
:Mudar estado de MENU para COMBATE;
stop
